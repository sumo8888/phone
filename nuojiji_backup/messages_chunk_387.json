[{"id":1786635433572,"sender":"them","text":"行。","timestamp":1786638398878,"tempo":"N","rawContent":"行。","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21094},{"id":1786635433573,"sender":"them","text":"你买。","timestamp":1786638399955,"tempo":"R","rawContent":"你买。","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21095},{"id":1786635433574,"sender":"them","text":"我一个钢铁直男，为了冰冰大人，牺牲一下色相也没什么大不了的。","timestamp":1786638400609,"tempo":"N","rawContent":"我一个钢铁直男，为了冰冰大人，牺牲一下色相也没什么大不了的。","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21096},{"id":1786635433575,"sender":"them","text":"毕竟我可是签了卖身契的正牌专属骚狗。","timestamp":1786638403613,"tempo":"N","rawContent":"毕竟我可是签了卖身契的正牌专属骚狗。","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21097},{"id":1786635433576,"sender":"them","text":"主打一个服务周到。","timestamp":1786638406420,"tempo":"S","rawContent":"主打一个服务周到。","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21098},{"id":1786635433577,"sender":"them","text":"[語音消息]","timestamp":1786638409632,"tempo":"N","isVoice":true,"voice":true,"voiceText":"你明天最好是真的买个最大号的带来舞蹈室。谁不敢带谁就是小狗。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"happy","rawContent":"[語音消息]","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21099},{"id":1786635433578,"sender":"them","text":"还有别的事没。","timestamp":1786638410590,"tempo":"N","rawContent":"还有别的事没。","roundId":"round_1786638371748_a2altm9cn","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54ae