:"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21108},{"id":1786635433588,"sender":"them","text":"今天先放过你。","timestamp":1786638670674,"tempo":"N","rawContent":"今天先放过你。","roundId":"round_1786638614022_8f9h532an","isHtml":false,"userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21109},{"id":1786635433589,"sender":"them","text":"你最好明天真的有胆子把东西带来。","timestamp":1786638673104,"tempo":"N","rawContent":"你最好明天真的有胆子把东西带来。","roundId":"round_1786638614022_8f9h532an","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21110},{"id":1786635433590,"sender":"them","text":"[語音消息]","timestamp":1786638675945,"tempo":"N","isVoice":true,"voice":true,"voiceText":"晚安，冰冰大人。做个好梦，明天见。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","rawContent":"[語音消息]","roundId":"round_1786638614022_8f9h532an","userId":"uid_1774875178105_sq25fuy8l","characterId":"a8644393-93b3-47d2-8519-47e54aec997c","_id":21111},{"id":1786667992500,"text":"$现在暂停主线剧情，为我生成一个小手机格式的番外，不需要正文不需要状态栏。\n恋爱期间的char十分爱胡思乱想敏感多疑\n$线上聊天：\nuser：告诉你个事\nchar：你出轨了是吗？\nuser：\n（下一次聊天）\nchar：什么时候下课？\nuser：好累\nchar：不分手。\nuser：\n（下一次聊天）\nchar：【视频通话请求被挂断】\nchar：谁送你回来的\nchar：那个男的是谁？你从谁车上下来的？\nuser：……那是出租车司机\nchar：\n（下一次聊天）\nchar：宝宝\nchar：老婆\n【十五分钟后】\nchar：在干嘛？\n【二十分钟后】\nchar：别出轨我求你了\nuser：\n之后user和char会这么说？对话要有来有往，消息数量不低于90句，禁止省略，禁止ooc，一次性生成完成，话风幽默搞笑，禁止有空格。","sender":"me","time":"09:24","timestamp":1786670673045,"replyTo":null,"userId":"uid_1774875178105_sq25fuy8l","characterId":"eef923d0-d42e-47a5-bf18-bc5a9560bd4f","_id":21112},{"id":1786667992502,"text":"<番外><!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no\"><title>聊天记录</title><style>*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}body{background-color:#f0f0f0;display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px}.phone-container{width:100%;max-width:400px;background-color:#ededed;border-radius:30px;box-shadow:0 10px 30px rgba(0,0,0,0.1);overflow:hidden;display:flex;flex-direction:column;height:800px;position:relative}.chat-header{background-color:#f5f5f5;padding:15px 20px;text-align:center;font-weight:bold;font-size:17px;color:#333;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;justify-content:space-between;z-index:10}.chat-header .back-btn{font-size:24px;color:#333;cursor:pointer}.chat-header .more-btn{font-size:24px;color:#333;cursor:pointer}.chat-body{flex:1;overflow-y:auto;padding:20px 15px;display:flex;flex-direction:column;gap:15px;background-color:#ededed}.time-divider{text-align:center;font-size:12px;color:#999;margin:10px 0}.message-row{display:flex;align-items:flex-start;max-width:100%;gap:10px;animation:fadeIn 0.3s ease-in-out}.message-row.me{flex-direction:row-reverse}.avatar{width:40px;height:40px;border-radius:5px;flex-shrink:0;background-color:#ccc;display:flex;justify-content:center;align-items:center;font-size:20px;color:#fff}.avatar.char{background-color:#2a2a2a}.avatar.user{background-color:#f4a460}.msg-bubble{padding:10px 15px;border-radius:8px;font-size:15px;line-height:1.5;max-width:70%;position:relative;word-wrap:break-word}.msg-bubble.char{background-color:#fff;color:#333;border:1px solid #e0e0e0;border-radius:0 8px 8px 8px}.msg-bubble.user{background-color:#95ec69;color:#333;border-radius:8px 0 8px 8px}.msg-bubble.sys{background-color:#e0e0e0;color:#666;font-size:12px;padding:5px 10px;border-radius:15px;margin:0 auto;max-width:80%;text-align:center}.chat-input-area{background-color:#f5f5f5;padding:10px 15px;border-top:1px solid #e0e0e0;display:flex;align-items:center;gap:10px}.input-box{flex:1;background-color:#fff;border-radius:5px;padding:10px;font-size:15px;color:#333;min-height:40px}.send-btn{background-color:#07c160;color:#fff;border:none;border-radius:5px;padding:8px 15px;font-size:14px;font-weight:bold}@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}</style></head><body><div class=\"phone-container\"><div class=\"chat-header\"><div class=\"back-btn\">‹</div><div>安之遥 (重度缺爱版)</div><div class=\"more-btn\">…</div></div><div class=\"chat-body\" id=\"chatBody\"></div><div class=\"chat-input-area\"><div class=\"input-box\">按住 说话</div><div class=\"send-btn\">发送</div></div></div><script>const chatData=[{type:'time',text:'昨天 14:20'},{sender:'user',text:'告诉你个事'},{sender:'char',text:'你出轨了是吗？'},{sender:'user',text:'...我只是想说我晚上要吃火锅。'},{sender:'char',text:'和谁？男的女的？长得帅吗？有我打游戏厉害吗？'},{sender:'user',text:'和我妈！'},{sender:'char',text:'哦，阿姨好。阿姨没带别的相亲对象给你看吧？'},{sender:'user',text:'你脑子里到底装的什么废料！'},{sender:'char',text:'装的全是你啊宝宝，我这不是怕失去你嘛。'},{sender:'user',text:'闭嘴。'},{type:'time',text:'昨天 18:45'},{sender:'char',text:'什么时候下课？'},{sender:'user',text:'好累'},{sender:'char',text:'不分手。'},{sender:'user',text:'？？我什么时候说要分手了？'},{sender:'char',text:'你嫌我烦了，你觉得跟我在一起很累，你想去找那个不需要你秒回消息的野男人了！'},{sender:'user',text:'我是说我上课好累！上！课！'},{sender:'char',text:'哦，原来是这样。吓死我了，我已经在看黄浦江哪段比较适合跳了。'},{sender:'user',text:'你要不要这么极端啊喂！'},{sender:'char',text:'宝宝，没有你我怎么活啊，我就是一棵依附你生存的菟丝花~'},{sender:'user',text:'你见过187的菟丝花吗？'},{sender:'char',text:'那我是你的大型犬，汪！'},{type:'time',text:'今天 00:15'},{sender:'sys',text:'视频通话请求被拒绝'},{sender:'char',text:'谁送你回来的'},{sender:'char',text:'那个男的是谁？你从谁车上下来的？'},{sender:'user',text:'……那是出租车司机'},{sender:'char',text:'出租车司机为什么要看你？他是不是对你有意思？'},{sender:'user',text:'因为我还没付钱！！！'},{sender:'char',text:'哦，那是该付。你要没钱我给你转，不要拿自己的美色抵债！'},{sender:'user',text:'我只是扫个码而已！你能不能正常一点！'},{sender:'char',text:'我怎么不正常了？我半夜睡不着看你定位移动，刚好从窗户看到你下车，我关心你还有错啦？'},{sender:'user',text:'你大半夜不睡觉盯着我定位看？！'},{sender:'char',text:'这不是没你在身边，我空虚寂寞冷嘛。'},{sender:'user',text:'我明天带你去看精神科吧。'},{sender:'char',text:'医生肯定会说，这个病人没救了，他得了晚期相思病，只能靠老婆亲亲才能续命。'},{type:'time',text:'今天 09:30'},{sender:'char',text:'宝宝'},{sender:'char',text:'老婆'},{type:'time',text:'今天 09:45'},{sender:'char',text:'在干嘛？'},{type:'time',text:'今天 10:05'},{sender:'char',text:'别出轨我求你了'},{sender:'user',text:'我就拉了个屎，没带手机！！！'},{sender:'char',text:'拉屎为什么要半个小时？你是不是在厕所里跟别人发消息怕我看到？'},{sender:'user',text:'我便秘行不行！'},{sender:'char',text:'便秘？是不是最近火气大？还是背着我偷偷吃了什么好吃的没带我？'},{sender:'user',text:'你要是再啰嗦我就把你拉黑！'},{sender:'char',text:'别别别，老婆我错了！'},{sender:'char',text:'我就是控制不住我自己，一秒钟收不到你的消息，我就觉得你要抛弃我了。'},{sender:'user',text:'你个29岁的老男人能不能成熟一点？'},{sender:'char',text:'在老婆面前要什么成熟，我永远是你的三岁宝宝！'},{sender:'user',text:'滚。'},{sender:'char',text:'好嘞，滚到老婆怀里。'},{sender:'user',text:'我一会要去开会，手机静音，两个小时内别找我。'},{sender:'char',text:'开会？和谁开？老板是男的吗？同事有帅哥吗？'},{sender:'user',text:'全是大妈！满意了吧！'},{sender:'char',text:'那……大妈有没有儿子？会不会硬要把儿子介绍给你？'},{sender:'user',text:'安之遥！你是不是想死！'},{sender:'char',text:'死在你手里我也愿意，牡丹花下死做鬼也风流嘛~'},{sender:'user',text:'我真的拉黑了。'},{sender:'char',text:'[转账 5200元] 备注：老婆买奶茶喝，别拉黑我呜呜呜'},{sender:'user',text:'……看在钱的份上，饶你一次。'},{sender:'char',text:'嘿嘿，老婆收了我的钱，就是我的人了，盖章确认，不许反悔！'},{sender:'user',text:'你戏真多。'},{sender:'char',text:'只演给你看嘛。'},{type:'time',text:'今天 13:00'},{sender:'char',text:'宝宝，开完会了吗？'},{sender:'char',text:'有没有大妈给你推销儿子？'},{sender:'user',text:'刚开完，没有大妈，只有一堆报表。'},{sender:'char',text:'太好了！今天也是成功捍卫主权的一天！'},{sender:'user',text:'我要去吃饭了，饿死了。'},{sender:'char',text:'吃什么？要不要我给你点外卖？或者我直接买好送过去？'},{sender:'user',text:'不用，我和同事去楼下吃个快餐。'},{sender:'char',text:'同事？男的女的？'},{sender:'user',text:'女的！女的！女的！重要的事情说三遍！'},{sender:'char',text:'哦，那我就放心了。记得多吃点，你最近都瘦了。'},{sender:'user',text:'你眼睛是有什么透视功能吗？隔着屏幕知道我瘦了？'},{sender:'char',text:'我那是心电感应，连着你的心跳呢。'},{sender:'user',text:'越说越离谱。不理你了，吃饭去。'},{sender:'char',text:'去吧去吧，别看别的男的啊，男服务员也不行！'},{sender:'user',text:'……'},{type:'time',text:'今天 16:30'},{sender:'char',text:'老婆，我直播好累啊，求安慰。'},{sender:'user',text:'摸摸头。'},{sender:'char',text:'光摸头不够，还要亲亲。'},{sender:'user',text:'吧唧。'},{sender:'char',text:'嘿嘿，瞬间满血复活！'},{sender:'char',text:'刚才直播间有个女粉说想给我生猴子。'},{sender:'user',text:'哦？那你怎么说？'},{sender:'char',text:'我当然是严词拒绝了！我说我已经是名草有主的人了，我老婆会吃醋的！'},{sender:'user',text:'算你识相。'},{sender:'char',text:'老婆，那你有没有吃醋啊？'},{sender:'user',text:'没有。'},{sender:'char',text:'你为什么不吃醋！你是不是不爱我了！你是不是在外面有别的狗了！'},{sender:'user',text:'……安之遥，你是不是有那个大病。'},{sender:'char',text:'我有病，一种名为“缺了冰冰就会死”的绝症。'},{sender:'user',text:'行了行了，晚上想吃什么，我下班去买菜。'},{sender:'char',text:'只要是老婆做的，毒药我也吃！'},{sender:'user',text:'那好，晚上给你煮鹤顶红汤。'},{sender:'char',text:'没问题！只要能跟老婆死在一起，黄泉路上我也给你当导游！'},{sender:'user',text:'你是路痴，当个屁的导游。'},{sender:'char',text:'对哦……那我牵着你的手，你带我走！'},{sender:'user',text:'滚去直播吧你。'},{sender:'char',text:'遵命，老婆大人！'}];const chatBody=document.getElementById('chatBody');chatData.forEach((msg,index)=>{setTimeout(()=>{let el=document.createElement('div');if(msg.type==='time'){el.className='time-divider';el.innerText=msg.text}else if(msg.sender==='sys'){el.className='msg-bubble sys';el.innerText=msg.text}else{el.className=`message-row ${msg.sender==='char'?'me':''}`;const avatarIcon=msg.sender==='char'?'🎮':'🧊';const avatarClass=msg.sender==='char'?'char':'user';el.innerHTML=`<div class=\"avatar ${avatarClass}\">${avatarIcon}</div><div class=\"msg-bubble ${avatarClass}\">${msg.text}</div>`}chatBody.appendChild(el);chatBody.scrollTop=chatBody.scrollHeight},index*100)});</script></body></html></番外>","rawContent":"<番外><!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no\"><title>聊天记录</title><style>*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}body{background-color:#f0f0f0;display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px}.phone-container{width:100%;max-width:400px;background-color:#ededed;border-radius:30px;box-shadow:0 10px 30px rgba(0,0,0,0.1);overflow:hidden;display:flex;flex-direction:column;height:800px;position:relative}.chat-header{background-color:#f5f5f5;padding:15px 20px;text-align:center;font-weight:bold;font-size:17px;color:#333;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;justify-content:space-between;z-index:10}.chat-header .back-btn{font-size:24px;color:#333;cursor:pointer}.chat-header .more-btn{font-size:24px;color:#333;cursor:pointer}.chat-body{flex:1;overflow-y:auto;padding:20px 15px;display:flex;flex-direction:column;gap:15px;background-color:#ededed}.time-divider{text-align:center;font-size:12px;color:#999;margin:10px 0}.message-row{display:flex;align-items:flex-start;max-width:100%;gap:10px;animation:fadeIn 0.3s ease-in-out}.message-row.me{flex-direction:row-reverse}.avatar{width:40px;height:40px;border-radius:5px;flex-shrink:0;background-color:#ccc;display:flex;justify-content:center;align-items:center;font-size:20px;color:#fff}.avatar.char{background-color:#2a2a2a}.avatar.user{background-color:#f4a460}.msg-bubble{padding:10px 15px;border-radius:8px;font-size:15px;line-height:1.5;max-width:70%;position:relative;word-wrap:break-word}.msg-bubble.char{background-color:#fff;color:#333;border:1px solid #e0e0e0;border-radius:0 8px 8px 8px}.msg-bubble.user{background-color:#95ec69;color:#333;border-radius:8px 0 8px 8px}.msg-bubble.sys{background-color:#e0e0e0;color:#666;font-size:12px;padding:5px 10px;border-radius:15px;margin:0 auto;max-width:80%;text-align:center}.chat-input-area{background-color:#f5f5f5;padding:10px 15px;border-top:1px solid #e0e0e0;display:flex;align-items:center;gap:10px}.input-box{flex:1;background-color:#fff;border-radius:5px;padding:10px;font-size:15px;color:#333;min-height:40px}.send-btn{background-color:#07c160;color:#fff;border:none;border-radius:5px;padding:8px 15px;font-size:14px;font-weight:bold}@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}</style></head><body><div class=\"phone-container\"><div class=\"chat-header\"><div class=\"back-btn\">‹</div><div>安之遥 (重度缺爱版)</div><div class=\"more-btn\">…</div></div><div class=\"chat-body\" id=\"chatBody\"></div>